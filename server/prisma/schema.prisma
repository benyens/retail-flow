generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id      String   @id @default(cuid())
  name    String
  rut     String   @unique
  address String
  branches Branch[]

  @@map("companies")
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  name      String
  address   String
  isActive  Boolean @default(true)

  company          Company           @relation(fields: [companyId], references: [id])
  cashRegisters    CashRegister[]
  stocks           Stock[]
  users            UserBranch[]
  salesDocuments   SalesDocument[]
  purchaseInvoices PurchaseInvoice[]

  @@map("branches")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  rut          String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  branches UserBranch[]

  @@map("users")
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model ProductCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  category        ProductCategory?       @relation(fields: [categoryId], references: [id])
  variants        Variant[]
  allowedBranches ProductAllowedBranch[]

  @@index([name])
  @@map("products")
}

model ProductAllowedBranch {
  productId String
  branchId  String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, branchId])
  @@map("product_allowed_branches")
}

model VariantGroup {
  id          String  @id @default(cuid())
  name        String
  description String?

  variants       Variant[]
  wholesaleTiers WholesaleTier[]

  @@map("variant_groups")
}

model Variant {
  id               String    @id @default(cuid())
  productId        String
  variantGroupId   String
  sku              String    @unique
  name             String
  attributes       Json
  unit             String
  barcode          String?   @unique
  isActive         Boolean   @default(true)
  lastPurchaseCost Decimal?  @db.Decimal(12, 2)
  lastPurchaseDate DateTime?

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantGroup VariantGroup @relation(fields: [variantGroupId], references: [id])

  prices SalesVariantPrice[]
  stocks Stock[]

  @@index([variantGroupId])
  @@map("variants")
}

enum PriceListType {
  NORMAL
  MAYORISTA
}

model PriceList {
  id   String        @id @default(cuid())
  name String
  type PriceListType @unique

  variantPrices  SalesVariantPrice[]
  wholesaleTiers WholesaleTier[]

  @@map("price_lists")
}

model SalesVariantPrice {
  id          String  @id @default(cuid())
  variantId   String
  priceListId String
  price       Decimal @db.Decimal(12, 2)

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id])

  @@unique([variantId, priceListId])
  @@map("variant_prices")
}

model WholesaleTier {
  id             String  @id @default(cuid())
  variantGroupId String
  priceListId    String
  minQty         Int
  unitPrice      Decimal @db.Decimal(12, 2)

  variantGroup VariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
  priceList    PriceList    @relation(fields: [priceListId], references: [id])

  @@unique([variantGroupId, priceListId, minQty])
  @@map("wholesale_tiers")
}

model Stock {
  branchId    String
  variantId   String
  quantity    Decimal  @db.Decimal(12, 3)
  lastUpdated DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([branchId, variantId])
  @@map("stocks")
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RETURN
}

model InventoryMovement {
  id            String                @id @default(cuid())
  branchId      String
  type          InventoryMovementType
  referenceId   String?
  referenceType String?
  notes         String?
  createdAt     DateTime              @default(now())
  createdBy     String

  lines InventoryLine[]

  @@index([branchId, createdAt])
  @@map("inventory_movements")
}

model InventoryLine {
  id            String  @id @default(cuid())
  movementId    String
  variantId     String
  quantity      Decimal @db.Decimal(12, 3)
  previousStock Decimal @db.Decimal(12, 3)
  newStock      Decimal @db.Decimal(12, 3)

  movement InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@map("inventory_lines")
}

model CashRegister {
  id       String  @id @default(cuid())
  branchId String
  name     String
  code     String
  isActive Boolean @default(true)

  branch   Branch        @relation(fields: [branchId], references: [id])
  sessions CashSession[]

  @@unique([branchId, code])
  @@map("cash_registers")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id             String            @id @default(cuid())
  cashRegisterId String
  userId         String
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  initialFund    Decimal           @db.Decimal(12, 2)
  expectedCash   Decimal           @default(0) @db.Decimal(12, 2)
  declaredCash   Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  status         CashSessionStatus @default(OPEN)
  closingNotes   String?

  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  salesDocuments SalesDocument[]
  movements      CashMovement[]

  @@map("cash_sessions")
}

enum CashMovementType {
  IN
  OUT
}

enum CashMovementConcept {
  WITHDRAW_TO_SAFE
  PETTY_CASH_EXPENSE
  ADVANCE_EMPLOYEE
  BONUS_AGUINALDO
  REFUND_CUSTOMER
  OTHER
}

model CashMovement {
  id            String              @id @default(cuid())
  cashSessionId String
  type          CashMovementType
  concept       CashMovementConcept
  amount        Decimal             @db.Decimal(12, 2)
  reason        String
  employeeId    String?
  authorizedBy  String?
  createdAt     DateTime            @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

model Employee {
  id       String  @id @default(cuid())
  branchId String
  name     String
  rut      String  @unique
  position String
  isActive Boolean @default(true)

  advances EmployeeAdvance[]

  @@map("employees")
}

model EmployeeAdvance {
  id             String   @id @default(cuid())
  employeeId     String
  cashSessionId  String
  cashMovementId String   @unique
  type           String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_advances")
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  rut     String  @unique
  email   String?
  phone   String?
  address String?

  salesDocuments SalesDocument[]

  @@map("customers")
}

enum DocumentType {
  BOLETA
  FACTURA
  CREDIT_NOTE
}

enum DocumentStatus {
  PENDING_ISSUE
  ISSUED
  REJECTED
  VOID_INTERNAL
}

enum PriceSource {
  NORMAL
  WHOLESALE
  MANUAL
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  OTHER
}

model SalesDocument {
  id            String         @id @default(cuid())
  branchId      String
  cashSessionId String
  customerId    String?
  docType       DocumentType
  status        DocumentStatus @default(PENDING_ISSUE)
  folio         String?
  subtotal      Decimal        @db.Decimal(12, 2)
  tax           Decimal        @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  createdBy     String

  branch      Branch      @relation(fields: [branchId], references: [id])
  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])

  lines    SalesLine[]
  payments Payment[]
  dte      DTERequest?

  @@index([branchId, createdAt])
  @@map("sales_documents")
}

model SalesLine {
  id                        String      @id @default(cuid())
  salesDocumentId           String
  variantId                 String
  variantGroupId            String
  quantity                  Decimal     @db.Decimal(12, 3)
  unitPrice                 Decimal     @db.Decimal(12, 2)
  priceSource               PriceSource
  wholesaleMinQtyApplied    Int?
  wholesaleUnitPriceApplied Decimal?    @db.Decimal(12, 2)
  subtotal                  Decimal     @db.Decimal(12, 2)

  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)

  @@map("sales_lines")
}

model Payment {
  id              String        @id @default(cuid())
  salesDocumentId String
  cashSessionId   String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  createdAt       DateTime      @default(now())

  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum DTEStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

model DTERequest {
  id                 String    @id @default(cuid())
  salesDocumentId    String    @unique
  status             DTEStatus @default(PENDING)
  providerName       String    @default("INTERNAL_STUB")
  providerExternalId String?
  folio              String?
  siiTrackId         String?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)

  @@map("dte_requests")
}

model DocFolioCounter {
  branchId  String
  docType   DocumentType
  lastFolio Int          @default(0)

  @@id([branchId, docType])
  @@map("doc_folio_counters")
}

enum RefType {
  ANULACION_TOTAL
  DEVOLUCION_PARCIAL
  CORRECCION_MONTO
}

model SalesDocumentReference {
  id                 String  @id @default(cuid())
  creditNoteId       String  @unique
  originalDocumentId String
  refType            RefType

  @@map("sales_document_references")
}

model Supplier {
  id           String  @id @default(cuid())
  name         String
  rut          String  @unique
  email        String?
  phone        String?
  address      String?
  isActive     Boolean @default(true)
  businessLine String?

  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
}

enum PurchaseInvoiceStatus {
  DRAFT
  SII_SENT
  SII_ACCEPTED
  SII_REJECTED
}

model PurchaseInvoice {
  id            String                @id @default(cuid())
  branchId      String
  supplierId    String
  invoiceNumber String
  invoiceDate   DateTime
  notes         String?
  subtotal      Decimal               @db.Decimal(12, 2)
  tax           Decimal               @db.Decimal(12, 2)
  total         Decimal               @db.Decimal(12, 2)
  status        PurchaseInvoiceStatus @default(DRAFT)
  siiTrackId    String?
  lastError     String?
  createdAt     DateTime              @default(now())
  createdBy     String
  updatedAt     DateTime              @updatedAt

  branch   Branch         @relation(fields: [branchId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  lines    PurchaseLine[]

  @@index([branchId, createdAt])
  @@map("purchase_invoices")
}

model PurchaseLine {
  id                String  @id @default(cuid())
  purchaseInvoiceId String
  variantId         String
  quantity          Decimal @db.Decimal(12, 3)
  unitCost          Decimal @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_lines")
}

/// Solo se escribe en un puñado de acciones sensibles hoy (anular venta,
/// nota de crédito, cambio de rol de usuario) -- NO es un audit trail
/// automático de toda mutación del sistema. Ver README para el detalle
/// de qué está cubierto y qué no.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Store only a digest, never a reusable bearer token.
model RevokedToken {
  tokenHash String @id
  expiresAt DateTime
  @@index([expiresAt])
  @@map("revoked_tokens")
}
